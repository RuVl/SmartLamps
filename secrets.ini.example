; Copy to secrets.ini (gitignored). Values here override the [secrets] section
; in platformio.ini.
[secrets]
; Password of the lamp's own access point (SSID = lamp name, e.g. lamp-a4f2).
; WPA2 needs at least 8 characters.
ap_pass = smartlamp
; OTA password: espota.py / pio run -t upload need it as --auth / upload_flags.
ota_pass = smartlamp
; Initial web panel password, applied on the first boot of a fresh database.
; Change it later in the panel (Система → Пароль панели). Empty disables it.
panel_pass = smartlamp
